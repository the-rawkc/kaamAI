# KaamAI local development settings
# Copy to .env. This file contains placeholders only; never commit real credentials.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

VITE_APP_NAME=KaamAI
VITE_API_BASE_URL=

# When VITE_API_BASE_URL is empty, the frontend makes relative /api requests
# which are proxied to http://localhost:4000 by Vite during development.
# Set this to an absolute URL (e.g. http://localhost:4000) for production or
# when running the frontend and backend on different hosts.

# Phase 2 database/auth settings
DATABASE_URL=postgresql://kaamai:change_me@localhost:5432/kaamai
SESSION_SECRET=replace_with_a_long_random_secret

# AI Provider Configuration:
# - Set AI_PROVIDER=ollama to run 100% locally with Ollama (0 API cost, zero key needed)
# - Set AI_PROVIDER=gemini to run on a free dev server with a free Google Gemini API key
AI_PROVIDER=ollama

# Option A: Local Ollama (Default for local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=embeddinggemma
VECTOR_BACKEND=pgvector

# Option B: Free Cloud Dev Server with Google Gemini API (Free key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Document/agent limits
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
MAX_AGENT_STEPS=5
AI_REQUESTS_PER_USER_PER_DAY=30
