# KaamAI Production / Cloud Dev Environment Configuration
# Copy to .env. Replace all placeholder values with secure secrets.

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://your-domain.com

# PostgreSQL Connection String (e.g. Neon.tech, Supabase, Railway, or local Docker)
DATABASE_URL=postgresql://kaamai:STRONG_SECURE_PASSWORD@db:5432/kaamai?sslmode=prefer

# 32+ character random session secret (required by server startup in production)
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# AI Engine configuration: 'ollama' or 'gemini'
AI_PROVIDER=ollama

# Option A: Local / Docker Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=embeddinggemma
VECTOR_BACKEND=pgvector

# Option B: Free Cloud Dev Server with Google Gemini API (Free key from https://aistudio.google.com)
# Recommended for free-tier cloud servers (Render, Railway, Fly.io, Codespaces) with limited RAM
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Storage and Quotas
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=15
MAX_AGENT_STEPS=5
AI_REQUESTS_PER_USER_PER_DAY=100
